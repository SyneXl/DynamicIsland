<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.30.0</Version>
  </PropertyGroup>

  <!-- Deterministic media-provider doubles are opt-in for regression tests only. -->
  <PropertyGroup Condition="'$(MediaTestApi)' == 'true'">
    <DefineConstants>$(DefineConstants);MEDIA_TEST_API</DefineConstants>
    <OutputPath>bin\$(Configuration)\media-test-api\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\media-test-api\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Resource Include="Fonts\*.otf;Fonts\*.ttf" />
    <Resource Include="Gadgets\*.png" />
    <EmbeddedResource Include="Notices\UsageLoop-MIT.txt" />
    <EmbeddedResource Include="Notices\Throne-api-MIT.txt;Notices\BouncyCastle-MIT.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(MediaTestApi)' == 'true'">
    <Compile Include="Tests\Fakes\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
