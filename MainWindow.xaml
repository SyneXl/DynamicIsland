                    </StackPanel>
                </Grid>

                <Grid x:Name="ShelfNoteView" Width="380" Height="276" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="18,8,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <Button Style="{StaticResource BackButton}" Content="ЗАМЕТКА" Click="ShelfNoteDone_Click" HorizontalAlignment="Left"/>
                        <Button Style="{StaticResource ChipButton}" Width="102" Height="26" HorizontalAlignment="Right" Content="Копировать"
                                Click="ShelfNoteCopy_Click" ToolTip="Скопировать текст"/>
                        <ScrollViewer x:Name="ShelfNoteScroll" Grid.Row="1" Style="{StaticResource MenuScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox x:Name="ShelfNoteEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MinHeight="145"
                                     MaxLength="1000000" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0"
                                     FontSize="13" Padding="6,8" ContextMenu="{x:Null}" SelectionBrush="#557D7AFF" AutomationProperties.Name="Текст заметки"/>
                        </ScrollViewer>
                        <Button Grid.Row="2" Style="{StaticResource ChipButton}" Content="Готово" Height="28" Width="90"
                                Click="ShelfNoteDone_Click" HorizontalAlignment="Right" ToolTip="Сохранить (Ctrl+Enter)"/>
                        <TextBlock x:Name="ShelfNoteError" Grid.Row="3" Foreground="{StaticResource Red}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <Grid x:Name="ShelfView" Width="380" Height="136" HorizontalAlignment="Center" VerticalAlignment="Top" Focusable="True">
                    <Grid Height="24" Margin="22,12,16,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Caption}" Text="ПОЛКА" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ShelfPasteButton" Style="{StaticResource ChipButton}" Width="26" Height="24" Margin="0,0,5,0" Click="ShelfPaste_Click" ToolTip="Вставить (Ctrl+V)" AutomationProperties.Name="Вставить из буфера">
                                <local:Icon Kind="Tray" Width="13" Height="13" Fill="{StaticResource Dim}"/>
                            </Button>
                            <Button x:Name="ShelfNoteButton" Style="{StaticResource ChipButton}" Width="26" Height="24" Margin="0,0,5,0" Click="ShelfNoteNew_Click" ToolTip="Новая заметка" AutomationProperties.Name="Новая заметка">
                                <local:Icon Kind="Lines" Width="13" Height="13" Fill="{StaticResource Dim}"/>
                            </Button>
                            <Button Style="{StaticResource ChipButton}" Width="26" Height="24" Margin="0,0,5,0" Click="ShelfAdd_Click" ToolTip="Добавить файлы" AutomationProperties.Name="Добавить файлы">
                                <local:Icon Kind="Plus" Width="12" Height="12" Fill="{StaticResource Dim}"/>
                            </Button>
                            <Button x:Name="ShelfClear" Style="{StaticResource ChipButton}" Height="22" Margin="0" FontSize="11"
                                    Click="ShelfClear_Click">
                                <TextBlock Text="Очистить" Margin="10,0" Foreground="{StaticResource Dim}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle x:Name="ShelfZone" Margin="14,40,14,12" RadiusX="16" RadiusY="16"
                               Stroke="White" StrokeThickness="1.5" StrokeDashArray="3 2.5" Fill="#0AFFFFFF" Opacity="0"
                               IsHitTestVisible="False"/>
                    <Button x:Name="ShelfHint" Style="{StaticResource PlainButton}" Margin="14,40,14,12" Click="ShelfAdd_Click"
                            MouseEnter="ShelfHint_MouseHover" MouseLeave="ShelfHint_MouseHover">
                        <StackPanel>
                            <local:Icon Kind="Tray" Width="22" Height="22" Fill="{StaticResource Dim}"/>
                            <TextBlock x:Name="ShelfHintText" Text="Перетащите сюда файлы" FontSize="12" Foreground="{StaticResource Dim}"
                                       Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ShelfHintMore" Text="Перетащи сюда или вставь из буфера" FontSize="11" Foreground="{StaticResource Faint}"
                                       Margin="0,1,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="ShelfStrip" Margin="18,36,18,10" ClipToBounds="True">
                        <Border.OpacityMask>
                            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="344,0">
                                <GradientStop x:Name="ShelfEdgeLeft" Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.05"/>
                                <GradientStop Color="Black" Offset="0.95"/>
                                <GradientStop x:Name="ShelfEdgeRight" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Canvas>
                            <StackPanel x:Name="ShelfTiles" Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ShelfMove"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="ShelfStatus" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="14,0,14,2" Visibility="Collapsed"/>
                </Grid>

                <Grid x:Name="WeatherView" Width="340" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel x:Name="WeatherBody" Margin="10,8,10,0" VerticalAlignment="Top">
                        <local:RowList>
                            <Button Style="{StaticResource BackButton}" Content="ПОГОДА" Click="SettingsBack_Click"/>
                        </local:RowList>
                        <Grid x:Name="WeatherNow" Margin="12,0,12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <local:Icon x:Name="WeatherIcon" Kind="Sun" Width="38" Height="38" VerticalAlignment="Center"/>
                                <local:Digits x:Name="WeatherDegrees" FontSize="42" FontWeight="SemiBold"
                                              FontFamily="{StaticResource Display}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="WeatherSky" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="WeatherFeels" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"
                                           HorizontalAlignment="Right"/>
                                <TextBlock x:Name="WeatherWind" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid x:Name="WeatherHours" Rows="1" Margin="4,12,4,0"/>
                        <StackPanel x:Name="WeatherNote" Margin="12,2,12,0">
                            <TextBlock x:Name="WeatherNoteTitle" FontSize="21" FontWeight="SemiBold"
                                       FontFamily="{StaticResource Display}"/>
                            <TextBlock x:Name="WeatherNoteText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="WeatherAction" Style="{StaticResource ChipButton}" Height="36" Margin="-8,14,-8,0"
                                    FontSize="13.5" FontWeight="SemiBold" Click="WeatherAction_Click"/>
                        </StackPanel>
                        <local:RowList Margin="0,10,0,0">
                            <Button Style="{StaticResource RowButton}" Click="PlaceRow_Click">
                                <Grid>
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Pin"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Место"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="PlaceText" Foreground="{StaticResource Dim}" MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <local:Icon Style="{StaticResource RowChevron}" Margin="8,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </local:RowList>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PlaceView" Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel x:Name="PlaceBody" Margin="10,8,10,0" VerticalAlignment="Top">
                        <local:RowList>
                            <Button Style="{StaticResource BackButton}" Content="МЕСТО" Click="PlaceBack_Click"/>
                            <Button Style="{StaticResource RowButton}" Click="PlaceAuto_Click">
                                <Grid>
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Location"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Определять автоматически"/>
                                    <local:Icon x:Name="PlaceAutoCheck" Kind="Check" Width="14" Height="14" Fill="White"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </local:RowList>
                        <Border Background="#1FFFFFFF" CornerRadius="12" Height="36" Margin="2,8,2,4" Cursor="IBeam"
                                MouseLeftButtonDown="PlaceField_MouseLeftButtonDown">
                            <Grid Margin="12,0">
                                <local:Icon Kind="Search" Width="15" Height="15" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlaceHint" Text="Найти город" FontSize="13.5" Foreground="{StaticResource Faint}"
                                           Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="PlaceQuery" Margin="25,0,0,0" Padding="0" FontSize="13.5" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                         TextChanged="PlaceQuery_TextChanged" PreviewKeyDown="PlaceQuery_PreviewKeyDown"/>
                            </Grid>
                        </Border>
                        <local:RowList x:Name="PlaceResults"/>
                        <TextBlock x:Name="PlaceStatus" FontSize="12" Foreground="{StaticResource Dim}" Margin="14,6,14,0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="QrView" Width="320" Height="104" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="10,8,10,0" VerticalAlignment="Top">
                        <local:RowList>
                            <Button Style="{StaticResource BackButton}" Content="QR-КОД С ЭКРАНА" Click="SettingsBack_Click"/>
                        </local:RowList>
                        <UniformGrid Rows="1" Margin="2,4,2,0">
                            <Button Style="{StaticResource ChipButton}" Height="40" FontSize="13.5" FontWeight="SemiBold"
                                    Content="Весь экран" Click="QrScreen_Click"/>
                            <Button Style="{StaticResource ChipButton}" Height="40" FontSize="13.5" FontWeight="SemiBold"
                                    Content="Выбрать область" Click="QrArea_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Canvas x:Name="Shared" Visibility="Collapsed" Opacity="0">
                <Grid x:Name="ArtSpot" Width="64" Height="64" MouseLeftButtonUp="Art_MouseLeftButtonUp">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtSize"/>
                            <TranslateTransform x:Name="ArtMove"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="{StaticResource ArtPlaceholder}">
                        <local:Icon Kind="Note" Width="30" Height="30" Fill="{StaticResource Dim}"/>
                    </Border>
                    <local:Cover x:Name="Art" Radius="16"/>
                </Grid>
                <local:Equalizer x:Name="Eq" Bars="8" Few="5" Width="21" Height="16" IsHitTestVisible="False">
                    <local:Equalizer.RenderTransform>
                        <TranslateTransform x:Name="EqMove"/>
                    </local:Equalizer.RenderTransform>
                </local:Equalizer>
            </Canvas>
            <Canvas>
                <Button x:Name="PagePrevious" Style="{StaticResource PageArrow}" Click="PagePrevious_Click"
                                ToolTip="Предыдущая страница&#x0a;Ctrl + колесо" AutomationProperties.Name="Предыдущая страница острова">
                    <local:Icon Kind="Back" Width="10" Height="14" Fill="White"/>
                </Button>
                <Button x:Name="PageNext" Style="{StaticResource PageArrow}" Click="PageNext_Click"
                                ToolTip="Следующая страница&#x0a;Ctrl + колесо" AutomationProperties.Name="Следующая страница острова">
                    <local:Icon Kind="Back" Width="10" Height="14" Fill="White" RenderTransformOrigin="0.5,0.5">
                        <local:Icon.RenderTransform><ScaleTransform ScaleX="-1"/></local:Icon.RenderTransform>
                    </local:Icon>
                </Button>
            </Canvas>
        </Grid>

        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Transparent" Padding="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="BubbleBody" ClipToBounds="True">
                <Grid x:Name="BubbleRecord" Width="76" HorizontalAlignment="Left">
                    <Ellipse x:Name="BubbleRecordDot" Width="9" Height="9" Fill="{StaticResource Red}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <local:Digits x:Name="BubbleRecordText" Text="0:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Red}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <Grid x:Name="BubbleTimer" Width="76" HorizontalAlignment="Left">
                    <local:Ring x:Name="BubbleRing" Width="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <StackPanel x:Name="BubbleShelf" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,13,0">
                    <local:Icon Kind="Tray" Width="15" Height="15" VerticalAlignment="Center"/>
                    <local:Digits x:Name="BubbleShelfText" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <Grid x:Name="BubbleUpdate" Width="38" HorizontalAlignment="Right" ToolTip="Доступно обновление">
                    <local:Icon Kind="Update" Width="17" Height="17" Fill="{StaticResource Indigo}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
